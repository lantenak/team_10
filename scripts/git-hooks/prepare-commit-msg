#!/bin/sh
# Удаляет автоматический Co-authored-by от Cursor из сообщения коммита.
MSG_FILE=$1
[ -f "$MSG_FILE" ] || exit 0
if sed --version 2>/dev/null | grep -q GNU; then
  sed -i '/[Cc]o-authored-by: Cursor/d' "$MSG_FILE"
  sed -i '/Made-with: Cursor/d' "$MSG_FILE"
else
  sed -i '' '/[Cc]o-authored-by: Cursor/d' "$MSG_FILE"
  sed -i '' '/Made-with: Cursor/d' "$MSG_FILE"
fi

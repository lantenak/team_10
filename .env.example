# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_RESCUE_MODEL=google/gemini-2.5-pro
# LLM_TIMEOUT_SEC=4.5
# RESCUE_TIMEOUT_SEC=5.0
# LLM_MAX_TOKENS=120
# USE_PRO_RESCUE=true
# USE_PAIRWISE=true

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...

# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL_PRO=google/gemini-2.5-pro
# USE_PRO_PRIMARY=true
# BINARY_USE_FLASH=true
# RECALL_MAX_MODE=true
# LLM_TIMEOUT_SEC=4.5
# LLM_MAX_TOKENS=120

# Debug: JSONL-лог входящих /check на сервере (только если правила хакатона разрешают)
# DEBUG_LOG_CHECKS=true
# DEBUG_LOG_PATH=logs/check_requests.jsonl
# DEBUG_LOG_RAW_SESSION_ID=false

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...

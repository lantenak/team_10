# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Основная модель (OpenRouter): openai/gpt-4o-mini | openai/gpt-4o | google/gemini-2.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini
# LLM_TIMEOUT_SEC=4.0
# LLM_MAX_TOKENS=120

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...

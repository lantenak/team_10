# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Основная модель (быстрая классификация)
# OPENROUTER_MODEL=google/gemini-2.5-pro
# LLM_TIMEOUT_SEC=4.5
# Второй проход (по умолчанию выключен — включать только для A/B)
# OPENROUTER_VALIDATOR_MODEL=google/gemini-2.5-pro
# VALIDATOR_TIMEOUT_SEC=5.0
# VALIDATOR_ENABLED=0

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...

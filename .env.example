# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Основная модель (быстрая классификация)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# LLM_TIMEOUT_SEC=4.5
# Валидатор (второй проход, по умолчанию Opus 4.8)
# OPENROUTER_VALIDATOR_MODEL=anthropic/claude-opus-4.8
# VALIDATOR_TIMEOUT_SEC=6.0
# VALIDATOR_ENABLED=1

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...
